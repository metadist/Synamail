{
  "name": "synamail",
  "version": "0.1.0",
  "private": true,
  "description": "Synamail - Outlook add-in for Synaplan",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vue-tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0 && prettier --check \"**/*.{ts,vue,json,md,html,css,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,vue,json,md,html,css,yml,yaml}\" && eslint . --fix",
    "check:types": "vue-tsc -b --noEmit",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:e2e": "playwright test",
    "validate": "office-addin-manifest validate manifest.xml",
    "sideload": "office-addin-debugging start manifest.xml",
    "stop-sideload": "office-addin-debugging stop manifest.xml",
    "build-manifest": "office-addin-manifest-converter convert manifest_1-0-2_prod.xml -o manifest.unified.json",
    "generate:schemas": "echo 'Schema generation lands in Sprint 3 - see docs/FEATURES.md section 6.' && exit 0"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "zod": "^4.6.5"
  },
  "overrides": {
    "strip-bom": "3.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/office-js": "^1.0.609",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.7",
    "office-addin-manifest": "^2.1.3",
    "office-addin-manifest-converter": "^0.4.1",
    "office-addin-validator": "^1.0.5",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}
